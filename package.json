{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "pts-core",
    "version": "1.0.0",
    "author": "pTSern",
    "editor": ">=3.8.8",
    "description": "Core dependency extension providing shared plugins and scripts/utils.",
    "main": "./bootstrap.js",
    "scripts": {
        "build": "tsc",
        "test:contract-resolution": "node scripts/test-contract-resolution.js",
        "watch": "tsc -w"
    },
    "panels": {
        "default": {
            "title": "pTS Core",
            "type": "dockable",
            "main": "dist/panel.js",
            "icon": "./static/icon.png",
            "flags": {
                "save": true
            },
            "size": {
                "min-width": 360,
                "min-height": 260,
                "width": 420,
                "height": 380
            }
        }
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./assets",
                "readonly": true
            }
        },
        "scene": {
            "script": "./src/_cc.js",
            "methods": [
                "log",
                "getClassInfo",
                "getComponentInfo",
                "updateComponent",
                "setNodeProperty",
                "addComponentToNode",
                "reloadExtension",
                "gameTap",
                "gameSwipe",
                "gameTapNode",
                "gameScreenshot",
                "gameQueryState",
                "gameEval",
                "pTS_get_animgraph_dump",
                "pTS_get_animgraph_runtime_state",
                "pTS_set_animgraph_variable",
                "pTS_set_animgraph_layer_weight",
                "pTS_log_animgraph_runtime",
                "gizmoRegister",
                "gizmoUnregister",
                "gizmoList",
                "gizmoScan"
            ]
        },
        "menu": [
            {
                "path": "i18n:menu.extension/pTS-Core",
                "label": "Settings",
                "message": "open-panel"
            }
        ],
        "profile": {
            "project": {
                "implement_check": {
                    "default": true,
                    "message": "profile::project::changed_implement_check",
                    "label": "Implement Check"
                }
            }
        },
        "project": {
            "tab_1": {
                "label": "pTS Core",
                "content": {
                    "implement_check": {
                        "ui": "ui-checkbox",
                        "attributes": {
                            "tooltip": "If enabled, @implement checks that the target class actually implements all contract properties and methods. Default: true."
                        }
                    }
                }
            }
        },
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "profile::project::changed_implement_check": {
                "methods": [
                    "onImplementCheckChanged"
                ]
            }
        }
    },
    "dependencies": {
        "@box2d/core": "^0.11.0",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "fs-extra": "^11.3.0",
        "playwright-core": "^1.64.1",
        "uuid": "^9.0.1",
        "vue": "^3.1.4",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^18.17.1",
        "@types/uuid": "^9.0.8",
        "typescript": "^5.8.2"
    }
}
